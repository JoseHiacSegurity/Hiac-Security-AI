{
  "manifest_version": 3,
  "name": "PhishGuard - Detector de phishing",
  "version": "0.2.0",
  "description": "Detecta señales de phishing localmente y en tiempo real.",
  "permissions": ["storage"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_title": "PhishGuard",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["src/rules.js", "src/content.js"],
    "run_at": "document_idle"
  }]
}